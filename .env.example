# Telegram
BOT_TOKEN=your_telegram_bot_token
WEBHOOK_URL=https://your-app.example.com
WEBHOOK_SECRET=random_secret_string

# Database
DATABASE_URL=postgresql+asyncpg://finances:finances@localhost:5432/finances

# Redis (local dev)
REDIS_URL=redis://localhost:6379/0
# Railway: REDIS_URL=${{Redis.REDIS_URL}}  — required for web + worker when WEBHOOK_URL is set

# Optional: OpenAI for text parsing (falls back to regex if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Railway: PORT is set automatically
# DATABASE_URL from Railway Postgres — change postgresql:// to postgresql+asyncpg://
